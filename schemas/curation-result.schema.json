{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-profile-harness/curation-result.schema.json",
  "title": "Curation Result",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/profileMemory"},
          {"$ref": "#/$defs/profileProposal"},
          {"$ref": "#/$defs/repoStatus"},
          {"$ref": "#/$defs/repoTasks"},
          {"$ref": "#/$defs/repoDecision"},
          {"$ref": "#/$defs/discard"}
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sources": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "content": {"type": "string", "minLength": 1, "maxLength": 64000},
    "profileMemory": {
      "type": "object", "required": ["type", "kind", "title", "content", "source_receipt_ids"],
      "properties": {"type": {"const": "profile_memory"}, "kind": {"enum": ["semantic", "procedural"]}, "title": {"$ref": "#/$defs/content"}, "content": {"$ref": "#/$defs/content"}, "source_receipt_ids": {"$ref": "#/$defs/sources"}},
      "additionalProperties": false
    },
    "profileProposal": {
      "type": "object", "required": ["type", "title", "content", "source_receipt_ids"],
      "properties": {"type": {"const": "profile_proposal"}, "title": {"$ref": "#/$defs/content"}, "content": {"$ref": "#/$defs/content"}, "source_receipt_ids": {"$ref": "#/$defs/sources"}},
      "additionalProperties": false
    },
    "repoStatus": {
      "type": "object", "required": ["type", "repository", "content", "source_receipt_ids"],
      "properties": {"type": {"const": "repo_status"}, "repository": {"type": "string", "minLength": 1, "maxLength": 128}, "content": {"$ref": "#/$defs/content"}, "source_receipt_ids": {"$ref": "#/$defs/sources"}},
      "additionalProperties": false
    },
    "repoTasks": {
      "type": "object", "required": ["type", "repository", "content", "source_receipt_ids"],
      "properties": {"type": {"const": "repo_tasks"}, "repository": {"type": "string", "minLength": 1, "maxLength": 128}, "content": {"$ref": "#/$defs/content"}, "source_receipt_ids": {"$ref": "#/$defs/sources"}},
      "additionalProperties": false
    },
    "repoDecision": {
      "type": "object", "required": ["type", "repository", "title", "content", "supersedes", "source_receipt_ids"],
      "properties": {"type": {"const": "repo_decision"}, "repository": {"type": "string", "minLength": 1, "maxLength": 128}, "title": {"$ref": "#/$defs/content"}, "content": {"$ref": "#/$defs/content"}, "supersedes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "maxLength": 20, "pattern": "^[0-9]+$"}}, "source_receipt_ids": {"$ref": "#/$defs/sources"}},
      "additionalProperties": false
    },
    "discard": {
      "type": "object", "required": ["type", "reason", "source_receipt_ids"],
      "properties": {"type": {"const": "discard"}, "reason": {"$ref": "#/$defs/content"}, "source_receipt_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}},
      "additionalProperties": false
    }
  }
}
