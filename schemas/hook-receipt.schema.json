{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-profile-harness/hook-receipt.schema.json",
  "title": "Hook Receipt",
  "type": "object",
  "required": [
    "id",
    "event",
    "captured_at",
    "cwd",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "event": {
      "enum": [
        "Stop",
        "SessionEnd"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"
    },
    "payload": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "cwd": {"type": "string", "maxLength": 1048576},
        "last_assistant_message": {"type": "string", "maxLength": 1048576},
        "permission_mode": {"type": "string", "maxLength": 1048576},
        "reason": {"type": "string", "maxLength": 1048576},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 1048576, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$"},
        "stop_hook_active": {"type": "boolean"},
        "transcript_path": {"type": "string", "maxLength": 1048576},
        "turn_id": {"type": "string", "maxLength": 1048576},
        "extra_keys": {"type": "array", "maxItems": 10000, "items": {"type": "string", "maxLength": 1048576}},
        "user_messages": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 1048576}},
        "assistant_messages": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 1048576}},
        "transcript_digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
        "capture_quality": {"type": "string", "enum": ["complete", "partial"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
