{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-profile-harness/hook-receipt.schema.json",
  "title": "Hook Receipt",
  "type": "object",
  "required": [
    "id",
    "event",
    "captured_at",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "enum": [
        "Stop",
        "SessionEnd"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
